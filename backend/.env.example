# env ของ api — คัดลอกเป็น backend/.env แล้วแก้ค่า (ไฟล์ .env ห้าม commit)
# DevOps ใช้ไฟล์นี้เป็นรายการ env บน server — env ที่ไม่อยู่ในไฟล์นี้จะไม่ถูกตั้ง (standards deployment.md ข้อ 4.2)
# ไฟล์นี้ห้ามมีค่าลับ: ค่าลับส่งให้ DevOps ทางข้อความส่วนตัวเท่านั้น

# dev: development · server: production
NODE_ENV=development
# dev: 4227 (frontend คู่กันใช้ 3227) · ใน container/server: 4000
PORT=4227

# ฐานข้อมูลของระบบนี้เท่านั้น (scholarship_db) — บน server DevOps กำหนดให้
# dev ใช้ฐานใน docker compose: docker compose up -d db
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/scholarship_db?schema=public
# จำนวน connection สูงสุดของระบบนี้ (PostgreSQL บน server ใช้ร่วมกันทุกระบบ — deployment.md ข้อ 4.1)
DATABASE_POOL_MAX=5

# ชื่อระบบ — ตรงกับทะเบียน Core Hub · subsystem.yaml · data.service ของ /api/health · ใช้ตรวจ azp ของ token
SUBSYSTEM_ID=csmju-scholarship

# Core Hub (connect-core-hub.md) — อ่านจาก env เสมอ ห้ามเขียนตายในโค้ด
CORE_HUB_URL=https://csmju2030.jowave.com
CORE_HUB_WEB_URL=https://csmju2030.jowave.com
# ระหว่างยังไม่ลงทะเบียนกับพอร์ทัลจริง ใช้พอร์ทัลจำลองในเครื่อง (pnpm dev:portal) แทน:
# CORE_HUB_URL=http://localhost:3000
# CORE_HUB_WEB_URL=http://localhost:3100

# สัญญาที่ตรึงไว้ — ห้ามเปลี่ยน
CORE_HUB_ISSUER=core-hub
CORE_HUB_AUDIENCE=csmju2030
# เรียกข้อมูลบุคคลจาก Core Hub (ms)
CORE_HUB_DATA_REQUEST_TIMEOUT_MS=5000

# ปกติหน้าเว็บส่งต่อคำขอผ่าน Next.js (origin เดียว) จึงไม่ต้องเปิด CORS — ว่างไว้
# ถ้าจะให้เว็บ origin อื่นเรียกตรง ใส่คั่นด้วย , เช่น http://localhost:3227
CORS_ORIGINS=

# ขนาดไฟล์แนบสูงสุดต่อไฟล์ (ไบต์) — ไม่เกิน 10 MB (deployment.md ข้อ 4.3) · ไฟล์เก็บในฐานข้อมูล
MAX_UPLOAD_BYTES=10485760

# server ตั้งให้: TZ=Asia/Bangkok
TZ=Asia/Bangkok
